# ===== 运行环境 =====
# development / test / production；不要将 development 配置暴露到公网。
APP_ENV=development

# ===== 数据库 =====
# driver: mysql | sqlite（sqlite 用于测试/离线开发）
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_diagnosis
DB_WRITE_USER=agent_app
DB_WRITE_PASSWORD=change_me
DB_READ_USER=agent_ro
DB_READ_PASSWORD=change_me
SQLITE_PATH=./dev.db

# ===== LLM (DeepSeek, OpenAI 兼容协议) =====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
# 每次 chat 的重试调度预算（调用方可覆盖）；同时是单次网络阶段超时上限，非硬墙钟取消。
LLM_TIMEOUT_SECONDS=60
# 额外重试次数，范围 0～5；3 = 首次请求 + 最多 3 次重试。SDK 内置重试已关闭。
LLM_MAX_RETRIES=3

# ===== Agent 安全上限 =====
AGENT_MAX_STEPS=8
AGENT_STEP_TIMEOUT_SECONDS=90
# 整个诊断从首次启动开始的预算，包含失败后的排队等待；恢复不会重置。
AGENT_TOTAL_TIMEOUT_SECONDS=300
# 累计已知输入 + 输出 token；失败请求未知用量不在此值中，不是硬计费上限。
AGENT_TOKEN_BUDGET=30000
# 请求前估算输入，限制单次输出并预留收尾；不是供应商账单硬上限
AGENT_MAX_OUTPUT_TOKENS=2048
# 单条反馈提炼：一次请求、不自动重试；同报告同反馈复用草稿
FEEDBACK_LLM_TOKEN_BUDGET=6000
FEEDBACK_LLM_MAX_OUTPUT_TOKENS=1200
FEEDBACK_LLM_TIMEOUT_SECONDS=30
FEEDBACK_MAX_DRAFTS_PER_REPORT=3
TOOL_RESULT_MAX_ROWS=50
TOOL_RESULT_MAX_CHARS=4000
LOG_DIR=./logs

# ===== API 安全 =====
# 旧式全权限 Key：仅开发/测试可用；production 必须清空 API_KEYS。
API_KEYS=dev-key-123
# 显式权限优先于旧式 Key。生产使用随机生成的至少 32 字符 Key，勿照抄示例值。
# JSON 格式，例如 {"你的只读Key":["report:read"],"你的诊断Key":["report:read","diagnosis:create","feedback:create"],"你的导入Key":["data:import"]}
API_KEY_SCOPES={}
API_RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=52428800
MAX_UPLOAD_ROWS=100000

# ===== MCP：本机 stdio 工具服务，默认关闭 =====
# 另建至少 32 字符随机 Key，在 API_KEY_SCOPES 中仅授予 tools:read；不要复用管理员 Key。
# MCP_ACCESS_KEY 由受信任启动者环境传入，不放在工具参数或公开客户端配置中。
# 旧式 API_KEYS、report:read 都不会自动获得 tools:read。
MCP_ENABLED=false
MCP_ACCESS_KEY=
MCP_TOOL_TIMEOUT_SECONDS=15
MCP_MAX_CONCURRENCY=2
MCP_MAX_RESULT_BYTES=131072
MCP_CALLS_PER_MINUTE=60

# ===== 告警 Webhook（留空 = 不发送；支持钉钉/企微/飞书等任意 POST 端点）=====
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# ===== 任务系统 =====
WORKER_CONCURRENCY=4
# 历史名称：这里表示包含首次在内的总尝试次数（1～10），不是额外重试次数。
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=5
TASK_POLL_INTERVAL_SECONDS=2
# 单次领取的租约；心跳间隔不得超过租约的 1/3。进程间时钟需同步。
TASK_LEASE_SECONDS=60
TASK_HEARTBEAT_SECONDS=15
TASK_RECOVERY_INTERVAL_SECONDS=15
